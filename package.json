{
  "name": "nextgo-browser-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test-browser.mjs && node scripts/test-browser.mjs --config tests/static.config.mjs",
    "test:browser": "node scripts/test-browser.mjs --project=production",
    "test:static": "node scripts/test-browser.mjs --config tests/static.config.mjs",
    "test:static:crossbrowser": "node scripts/test-browser.mjs --config tests/static-crossbrowser.config.mjs",
    "test:wasm": "sh scripts/test-wasm.sh",
    "test:shared-cache": "node scripts/test-browser.mjs --config tests/shared-cache.config.mjs",
    "test:shared-pages": "node scripts/test-browser.mjs --config tests/shared-pages.config.mjs",
    "test:crossbrowser": "node scripts/test-browser.mjs --config tests/crossbrowser.config.mjs",
    "test:shared-prerender": "node scripts/test-browser.mjs --config tests/shared-prerender.config.mjs",
    "test:stream-parser": "node scripts/test-browser.mjs --config tests/stream-parser.config.mjs",
    "test:stream-admission": "node scripts/test-browser.mjs --config tests/stream-admission.config.mjs",
    "test:partial": "node scripts/test-browser.mjs --config tests/partial.config.mjs",
    "test:partial-shell": "node scripts/test-browser.mjs --config tests/partial-shell.config.mjs",
    "test:viewport": "node scripts/test-browser.mjs --config tests/viewport.config.mjs",
    "test:generated-actions": "node scripts/test-browser.mjs --config tests/generated-actions.config.mjs",
    "test:action-view": "node --test tests/action-view-wire-observer.test.mjs && node scripts/test-browser.mjs --config tests/action-view.config.mjs",
    "test:cookie-dispatch": "node scripts/test-browser.mjs --config tests/cookie-dispatch.config.mjs",
    "test:resources": "node scripts/test-browser.mjs --config tests/resources.config.mjs",
    "test:embeds": "node scripts/test-browser.mjs --config tests/embeds.config.mjs",
    "test:social-image": "node scripts/test-browser.mjs --config tests/social-image.config.mjs",
    "test:lambda:features": "node --test tests/seven-feature-lambda.test.mjs",
    "test:lambda:browser": "node scripts/test-browser.mjs --config tests/lambda-features.config.mjs",
    "test:metadata-files": "node scripts/test-browser.mjs --config tests/metadata-files.config.mjs",
    "test:metadata-stream": "node scripts/test-browser.mjs --config tests/metadata-stream.config.mjs",
    "test:form-validation": "node scripts/test-browser.mjs --config tests/form-validation.config.mjs",
    "test:form-validation:deployment": "node --test tests/form-validation-deployment.test.mjs",
    "test:zones": "node scripts/test-browser.mjs --config tests/zones.config.mjs",
    "test:zones:dev": "node scripts/test-browser.mjs --config tests/zones-dev.config.mjs",
    "test:zones:deployment": "node --test tests/zones-deployment.gateway.test.mjs tests/zones-deployment.test.mjs tests/zones-deployment.cli.test.mjs",
    "test:zones:independent": "node scripts/test-browser.mjs --config tests/independent-zones-config.mjs",
    "test:zones:independent:deployment": "node --test tests/independent-zones-deployment.test.mjs",
    "test:refresh-dev": "node scripts/test-browser.mjs --config tests/refresh-dev.config.mjs",
    "test:refresh-production": "node --test tests/refresh-production.test.mjs",
    "test:refresh-production:browser": "node scripts/test-browser.mjs --config tests/refresh-production.config.mjs",
    "test:offline": "node scripts/test-browser.mjs --config tests/offline.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
